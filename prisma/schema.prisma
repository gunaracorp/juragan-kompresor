generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  brand       String
  type        String // ROTARY | SCROLL | PISTON | INVERTER
  refrigerant String // R32 | R410A | R22 | R134a | R404A
  capacity    Float // dalam PK
  voltage     String
  modelCode   String
  category    String // RESIDENTIAL | LIGHT_COMMERCIAL | INDUSTRIAL
  price       Int
  oldPrice    Int?
  stock       Int       @default(0)
  soldCount   Int       @default(0)
  rating      Float     @default(4.8)
  reviews     Int       @default(0)
  badge       String? // Terlaris | Best Value | Baru | Industrial | Stok Terbatas
  warranty    String
  image       String
  features    String // JSON array string
  compatible  String // JSON array string
  tierPrices  String // JSON array [{minQty, price}]
  description String
  isFeatured  Boolean   @default(false)
  saleEndsAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Article {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  content     String
  category    String
  readTime    Int      @default(5)
  publishedAt DateTime @default(now())
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  city      String
  role      String
  rating    Int      @default(5)
  message   String
  createdAt DateTime @default(now())
}

model Faq {
  id       String @id @default(cuid())
  question String
  answer   String
  order    Int    @default(0)
}

model QuoteRequest {
  id        String   @id @default(cuid())
  name      String
  phone     String
  address   String
  note      String?
  items     String // JSON array [{productId, name, qty, price}]
  total     Int
  status    String   @default("NEW")
  createdAt DateTime @default(now())
}
